#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
/ {
    keymap {
        compatible = "zmk,keymap";
        diagnostic {
            bindings = <
                &kp Q &kp W &kp E &kp R &kp T     &none &none &none &none &none
                &kp A &kp S &kp D &kp F &kp G     &none &none &none &none &none
                &kp Z &kp X &kp C &kp V &kp B     &none &none &none &none &none
                &kp ESC &kp TAB &kp LSHIFT &kp LCTRL &kp SPACE &kp ENTER &none &none &none
            >;
        };
    };
};
